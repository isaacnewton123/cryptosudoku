{
  "name": "cryptosudoku",
  "version": "0.1.0",
  "description": "CryptoSudoku — on-chain competitive Sudoku platform (BOT Chain). Ships versioned Agent Skills with the npm package via TanStack Intent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills/cryptosudoku-architecture",
    "skills/cryptosudoku-tokenomics",
    "!skills/_artifacts"
  ],
  "keywords": [
    "cryptosudoku",
    "sudoku",
    "gamefi",
    "tanstack-intent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "intent validate --check",
    "validate:fix": "intent validate --fix",
    "stale": "intent stale",
    "stale:json": "intent stale --json",
    "maintainer:status": "intent maintainer status",
    "maintainer:sync": "intent maintainer sync",
    "maintainer:check": "intent maintainer check",
    "list-skills": "intent list --no-notices",
    "prepack": "npm run build && npm run maintainer:sync"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.5",
    "typescript": "^5.6.0"
  },
  "intent": {
    "skills": [
      "cryptosudoku"
    ],
    "exclude": [
      "cryptosudoku#*-draft",
      "cryptosudoku#*-experimental"
    ]
  }
}
